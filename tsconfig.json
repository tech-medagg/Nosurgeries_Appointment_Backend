{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "rootDir": ".",
    "outDir": "./dist",

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "src/**/*",
    "drizzle.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}